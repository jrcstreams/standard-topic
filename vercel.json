{
  "crons": [
    {
      "path": "/api/cron/trending",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/pregenerate?type=trends&n=10",
      "schedule": "5 */4 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "30 7,8,19,20 * * *"
    },
    {
      "path": "/api/cron/embed",
      "schedule": "30 */12 * * *"
    },
    {
      "path": "/api/cron/pregenerate?type=daily&n=40",
      "schedule": "0 8,9,20,21 * * *"
    },
    {
      "path": "/api/cron/pregenerate?type=daily&n=40",
      "schedule": "12 8,9,20,21 * * *"
    },
    {
      "path": "/api/cron/release",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/pregenerate?type=budget",
      "schedule": "40 23 * * *"
    },
    {
      "path": "/api/cron/pregenerate?type=purge&scope=orphans",
      "schedule": "20 4 * * 0"
    }
  ],
